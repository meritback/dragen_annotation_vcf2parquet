/*
 * Config for the AggV3 annotation extraction pipeline.
 */
// process.container = 'meritback/aggv3-annotations:1.0.0-amd64'
process.container = 'meritback/aggv3-genotypes:1.0.4-amd64'

manifest {
    name            = 'aggv3-annotations'
    description     = 'AggV3 VEP-annotated msVCF to long-format annotation parquet'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {
    annotation_root  = null
    outdir           = 'results'
    shards           = 'shard-*'
    subshards        = 'subshard-*'
    vcf_name         = 'dragen.gel.annotated.vcf.gz'
    annotation_field = 'CSQ'
    max_af           = null
    max_ac           = null
    help             = false
}

process {
    // bcftools and python run concurrently, so a task needs ~2 cores. Measured
    // on a single subshard: bcftools ~80% CPU, polars ~20%, i.e. this is
    // bcftools-bound and cores translate into throughput almost linearly.
    //
    // Much lighter than the genotype pipeline throughout, for one reason: there
    // is no sample dimension. A genotype row is per sample per variant across
    // 138k samples; an annotation row is per variant per consequence. The ~200
    // CSQ columns look alarming but they are one variant's worth of strings,
    // not 138k.

    withLabel: process_low {
        cpus   = 1
        memory = 2.GB
        disk   = 5.GB
        time   = 1.h
    }

    // The intermediate TSV is the sizing constraint, not memory: ~200 columns
    // x (variants x transcripts) rows. Remeasure from report.html after the
    // pilot -- peak_rss and write_bytes in trace.txt are the two numbers that
    // matter, and disk especially may come down a long way.
    withLabel: process_medium {
        cpus   = 2
        memory = 8.GB
        disk   = 40.GB
        time   = 4.h
    }

    errorStrategy = { task.exitStatus in [104,134,137,138,139,143,247,2147483647] ? 'retry' : 'finish' }
    maxRetries    = 5

    // Give a retried task more room rather than failing the same way twice.
    withName: 'CONVERT_ANNOTATIONS' {
        memory = { 8.GB * task.attempt }
        //memory = { 16.GB * task.attempt }
        //disk   = { 40.GB * task.attempt }
    }

    // A schema mismatch is a real finding, not a transient fault: retrying
    // will produce the same answer five times and bury the message.
    withName: 'CHECK_SCHEMA' {
        errorStrategy = 'terminate'
        maxRetries    = 0
    }
}

profiles {
    standard {
        process.executor = 'local'
        // Cap local parallelism by disk, not cores: each task needs scratch for
        // its intermediate TSV in its own work dir.
        executor.queueSize = 8
    }

    // Sized for an interactive session. Each task is ~1.2 cores in practice
    // (bcftools ~80%, polars ~20%), so queueSize is roughly cores/1.5 with
    // headroom left for the session itself.
    local_small {
        process.executor   = 'local'
        executor.queueSize = 3
        executor.cpus      = 4
        executor.memory    = 28.GB
    }

    local_large {
        process.executor   = 'local'
        executor.queueSize = 32
        executor.cpus      = 128
        executor.memory    = 240.GB
    }

    cloudos {
        process.executor = 'awsbatch'
        // queue and region are injected by the CloudOS launcher.
        aws.batch.maxParallelTransfers = 8
        aws.batch.maxTransferAttempts  = 3
    }

    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    docker {
        docker.enabled    = true
        process.container = 'meritback/aggv3-genotypes:1.0.4-amd64' //'meritback/aggv3-annotations:1.0.0-amd64'
    }

    test {
        params.shards    = 'shard-1'
        params.subshards = 'subshard-1'
    }
}

// Reports are how the full run gets sized: per-task duration, CPU, memory and
// disk. Run the test profile first and read report.html before submitting 3100.
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,duration,realtime,%cpu,peak_rss,read_bytes,write_bytes'
}
